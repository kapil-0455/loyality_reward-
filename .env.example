# =============================================================================
# Loyalty & Reward Optimisation Platform - Environment Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit the actual .env file to version control.
# =============================================================================

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@host:5432/test_dbname?sslmode=require

# LLM & Agent Keys
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Security & Authentication
# Secret shared token used to protect manager routes (/rewards/approvals, /rewards/redemptions)
CAMPAIGN_MANAGER_API_TOKEN=your_campaign_manager_bearer_token_here

# Milvus Vector Database (Optional / Retrieval)
MILVUS_URI=https://your-milvus-cluster.zillizcloud.com
MILVUS_TOKEN=your_milvus_token_here

# Observability & Tracing (Langfuse - Optional)
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
